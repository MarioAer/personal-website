language js

// HTML is read with scripts/lib/html.ts, CSS with scripts/lib/css.ts, never with a regular expression.
or {
  JsRegexLiteralExpression() as $re where { $re <: r".*(?:<|@import|url.{1,2}[(]).*" },
  `new RegExp($source, $...)` as $re where { $source <: r".*(?:<|@import|url.{1,2}[(]).*" },
  `new RegExp($source)` as $re where { $source <: r".*(?:<|@import|url.{1,2}[(]).*" }
} where {
  register_diagnostic(
    span = $re,
    message = "Do not match markup or CSS with a regular expression: a pattern cannot follow the rules a browser applies to tags, comments, quoting and escapes. Read HTML with scripts/lib/html.ts (parse5) and CSS with scripts/lib/css.ts (css-tree)."
  )
}
